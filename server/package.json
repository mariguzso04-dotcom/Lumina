{
  "name": "lumina-server",
  "version": "1.0.0",
  "description": "API REST y capa de datos para LÚMINA",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "test": "node --test tests/api.test.js",
    "db:init:sqlite": "node src/db/migrate.js --engine=sqlite && node src/db/seed.js --engine=sqlite",
    "db:init:postgres": "node src/db/migrate.js --engine=postgres && node src/db/seed.js --engine=postgres"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "supertest": "^6.3.4"
  }
}
