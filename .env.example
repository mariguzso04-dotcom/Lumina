# =================================================================
# LÚMINA - Archivo de Configuración de Variables de Entorno (Ejemplo)
# =================================================================

# Entorno y Puerto del Servidor
NODE_ENV=development
PORT=5000

# Selección de Motor de Base de Datos: 'sqlite' o 'postgres'
DB_TYPE=sqlite

# Configuración SQLite (Desarrollo local / Pruebas)
SQLITE_PATH=./database/sqlite/lumina.db

# Configuración PostgreSQL (Producción / Entornos multiusuario)
# Opcional: URI completa
# DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/lumina
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=lumina
PG_USER=postgres
PG_PASSWORD=tu_contraseña_aqui
PG_SSL=false

# Seguridad y Autenticación JWT
JWT_SECRET=reemplazar_con_secreto_aleatorio_de_alta_entropia_32_caracteres_min
JWT_EXPIRES_IN=7d

# Origen CORS Permitido
CORS_ORIGIN=http://localhost:5173
